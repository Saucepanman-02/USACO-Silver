#include <bits/stdc++.h>

using namespace std;

#define speedup ios_base::sync_with_stdio(false); cin.tie(nullptr); cout.tie(nullptr);
#define usopen(filename) do{freopen(filename".in", "r", stdin); freopen(filename".out", "w", stdout);}while(0)
#define f first
#define s second
#define ll long long
#define db double
#define pii pair<int, int>
#define pll pair<ll, ll>
#define pdd pair<db, db>
#define vi vector<int>
#define EPS 1e-5
#define MAXD 12

ll n; 

int solve(ll c){
    ll cnt1 = 0, cnt2 = 0;
    for (ll i = 1; i <=  n; i++){
        cnt1 += min((c/i), n);
        cnt2 += min((c/i), n);
        if (c%i == 0 && c <= i*n){
            cnt1--;
        }
    }
    if (cnt2 >= (n*n+1)/2 && cnt1 < (n*n+1)/2){
        return 0;
    }else if (cnt1 >= (n*n+1)/2){
        return -1;
    }else{
        return 1;
    }
}

int main(){
    speedup
    cin >> n;
    ll l = 1, r = n*n, ans = 0;
    while (r >= l){
        ll m = (r+l)/2;
        int c = solve(m);
        if (c == 0){
            cout << m << endl;
            return 0;
        }else if (c == 1){
            l = m+1;
        }else{
            r = m-1;
        }
    }
    return 0;
}
