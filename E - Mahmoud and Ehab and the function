#include <bits/stdc++.h>

using namespace std;

#define speedup ios_base::sync_with_stdio(false); cin.tie(nullptr); cout.tie(nullptr);
#define usopen(filename) do{freopen(filename".in", "r", stdin); freopen(filename".out", "w", stdout);}while(0)
#define f first
#define s second
#define ll long long
#define db double
#define pii pair<int, int>
#define pll pair<ll, ll>
#define pdd pair<db, db>
#define vi vector<int>
#define EPS 1e-5
#define MAXD 12

int n, m, q;
vector<ll> a, b;
set<ll> st;

ll calc(ll sum){
    auto it1 = st.lower_bound(sum);
    if (it1 == st.begin()){
        return abs(*it1-sum);
    }
    auto it2 = it1;
    it2--;
    if (it1 == st.end()){
        return abs(*it2-sum);
    }
    return min(abs(*it1-sum), abs(*it2-sum));
}

int main(){
    speedup
    cin >> n >> m >> q;
    a.resize(n);
    b.resize(m);
    for (int i = 0; i < n; i++){
        cin >> a[i];
    }
    for (int i = 0; i < m; i++){
        cin >> b[i];
    }
    ll sum = 0;
    for (int i = 0; i < n; i++){
        sum += (i%2 == 1? -1: 1)*a[i];
    }
    ll cur = 0;
    for (int i = 0; i < n; i++){
        cur += (i%2 == 1? -1: 1)*b[i];
    }
    st.insert(cur);
    for (int i = 0; i < m-n; i++){
        cur -= (i%2 == 1? -1: 1)*b[i];
        cur += ((i+n)%2 == 1? -1: 1)*b[i+n];
        st.insert((i%2 == 0? -1: 1)*cur);
    }
    cout << calc(sum) << endl;
    for (int i = 0; i < q; i++){
        int l, r, x; cin >> l >> r >> x;
        l--, r--;
        if ((r-l+1)%2 == 1){
            if (l%2){
                sum -= x;
            }else{
                sum += x;
            }
        }
        cout << calc(sum) << endl;
    }
    return 0;
}
